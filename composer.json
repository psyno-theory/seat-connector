{
  "name": "warlof/seat-connector",
  "description": "Provide basic layer for SeAT connectors.",
  "type": "seat-plugin",
  "minimum-stability": "dev",
  "prefer-stable": true,
  "license": "GPL-3.0-or-later",
  "authors": [
    {
      "name": "Warlof Tutsimo",
      "email": "loic.leuilliot@gmail.com"
    },
    {
      "name": "Zenobio93",
      "email": "development@hellmund.eu"
    }
  ],
  "autoload": {
    "psr-4": {
      "Warlof\\Seat\\Connector\\": "src/",
      "Warlof\\Seat\\Connector\\Database\\Seeders\\": "src/database/seeders/"
    }
  },
  "require": {
    "php": "^8.1",
    "ext-json": "*",
    "eveseat/services": "^5.0",
    "eveseat/eveapi": "^5.0",
    "eveseat/web": "^5.0",
    "eveseat/api": "^5.0"
  },
  "extra": {
    "laravel": {
      "providers": [
        "Warlof\\Seat\\Connector\\SeatConnectorServiceProvider"
      ]
    },
    "branch-alias": {
      "dev-feature/strict-character-exemptions": "3.1.x-dev",
      "dev-feature/strict-exemptions-database": "3.1.x-dev"
    }
  },
  "require-dev": {
    "rector/rector": "^0.18.2",
    "driftingly/rector-laravel": "^0.24.1",
    "orchestra/testbench": "^8.0",
    "phpunit/phpunit": "^10.5"
  },
  "autoload-dev": {
    "psr-4": {
      "Warlof\\Seat\\Connector\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit"
  }
}
